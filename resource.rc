#pragma code_page(65001)

#include <windows.h>

#ifndef CREATEPROCESS_MANIFEST_RESOURCE_ID
#define CREATEPROCESS_MANIFEST_RESOURCE_ID 1
#endif
#ifndef RT_MANIFEST
#define RT_MANIFEST 24
#endif

// 嵌入现代视觉样式清单 (启用 Windows 10/11 ComCtl v6 现代 UI)
CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "app.manifest"

// 应用程序主图标 (ID = 1, 供 Windows 资源管理器与任务栏加载)
1 ICON "app.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     0,1,1,0
PRODUCTVERSION  0,1,1,0
FILEFLAGSMASK   0X3FL
FILEFLAGS       0X0L
FILEOS          VOS__WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     0X0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404B0"
        BEGIN
            VALUE "CompanyName",      "Sunplace"
            VALUE "FileDescription",  "来自kkii.org"
            VALUE "FileVersion",      "0.1.1.0"
            VALUE "InternalName",     "excel-toolkit"
            VALUE "LegalCopyright",   "Sunplace"
            VALUE "OriginalFilename", "excel-toolkit.exe"
            VALUE "ProductName",      "Excel工具箱"
            VALUE "ProductVersion",   "v0.1.1"
        END
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "Sunplace"
            VALUE "FileDescription",  "来自kkii.org"
            VALUE "FileVersion",      "0.1.1.0"
            VALUE "InternalName",     "excel-toolkit"
            VALUE "LegalCopyright",   "Sunplace"
            VALUE "OriginalFilename", "excel-toolkit.exe"
            VALUE "ProductName",      "Excel工具箱"
            VALUE "ProductVersion",   "v0.1.1"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x804, 1200, 0x409, 1200
    END
END

